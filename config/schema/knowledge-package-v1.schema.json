{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liumingyang-maker/daily-record-ocr-lite/schemas/knowledge-package-v1.schema.json",
  "title": "Daily Record OCR Knowledge Package Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "created_at",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "daily-record-knowledge-package-v1"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "minItems": 6,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 536870912
          }
        }
      }
    }
  }
}
