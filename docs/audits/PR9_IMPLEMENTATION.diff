+
+def test_rejects_output_inside_the_source_tree(tmp_path: Path) -> None:
+    source = tmp_path / "source"
+    _source_tree(source)
+
+    try:
+        main(
+            [
+                "stage",
+                "--source",
+                str(source),
+                "--staging",
+                str(source / "generated"),
+                "--run-id",
+                "unsafe-run",
+            ]
+        )
+    except ValueError as exc:
+        assert "原始资料目录" in str(exc)
