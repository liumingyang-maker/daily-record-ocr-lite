+    ) -> None:
+        issue = staged.issue
+        connection.execute(
+            """
+            INSERT INTO import_exclusions (
+                run_id, source_path, sheet_name, start_row, end_row,
+                reason, details, created_at
+            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?)
