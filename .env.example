APP_HOST=127.0.0.1
APP_PORT=8765
JOBS_DIR=data/jobs
KNOWLEDGE_DB=data/knowledge.sqlite3

RECOGNITION_MODE=auto
ACCURACY_MODE=dual

OCR_ENABLED=true
OCR_PROVIDER=paddleocr_v6
OCR_DEVICE=cpu
OCR_TIER=medium
OCR_MIN_SCORE=0.45

VISION_PROVIDER=mock
VISION_BASE_URL=http://127.0.0.1:11434/v1
VISION_ENDPOINT=/chat/completions
VISION_API_KEY=
VISION_MODEL=
VISION_TIMEOUT_SECONDS=180
VISION_USE_JSON_SCHEMA=false

ENABLE_HISTORY_MATCH=true
ENABLE_CONFLICT_RECHECK=true
ENABLE_CACHE=true
